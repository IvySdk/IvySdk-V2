<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="34">

            <ImageView
                android:id="@+id/ivy_cross_promotion_banner_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ivy_cross_promotion_banner_scrim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/ivy_cross_promotion_ad_badge_background"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="@string/ivy_cross_promotion_ad"
                android:textColor="@color/ivy_cross_promotion_white"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="66"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <ImageView
                android:id="@+id/ivy_cross_promotion_banner_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ivy_cross_promotion_banner_icon_background"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:padding="1dp"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="8dp"
                android:gravity="start"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ivy_cross_promotion_banner_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FF17211D"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ivy_cross_promotion_banner_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FF748078"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp">

                <TextView
                    android:id="@+id/ivy_cross_promotion_banner_cta"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/ivy_cross_promotion_cta_background"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxWidth="104dp"
                    android:maxLines="1"
                    android:minWidth="68dp"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/ivy_cross_promotion_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/ivy_cross_promotion_banner_loading"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/ivy_cross_promotion_white"
                    android:indeterminateTintMode="src_in"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
