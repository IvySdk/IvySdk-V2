<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ivy_cross_promotion_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <FrameLayout
        android:id="@+id/ivy_cross_promotion_media_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivy_cross_promotion_creative"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <VideoView
            android:id="@+id/ivy_cross_promotion_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/ivy_cross_promotion_video_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/ivy_cross_promotion_landing_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ivy_cross_promotion_landing_background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/ivy_cross_promotion_ad_badge_background"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/ivy_cross_promotion_ad"
                android:textColor="@color/ivy_cross_promotion_white"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="28dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivy_cross_promotion_landing_icon"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@null"
                android:elevation="4dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/ivy_cross_promotion_landing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#FF171A1F"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ivy_cross_promotion_landing_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="3"
                android:textColor="#FF747A84"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/ivy_cross_promotion_landing_cta"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/ivy_cross_promotion_landing_cta_background"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:maxWidth="280dp"
                android:paddingHorizontal="20dp"
                android:text="@string/ivy_cross_promotion_install"
                android:textColor="@color/ivy_cross_promotion_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ivy_cross_promotion_ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ivy_cross_promotion_ad_badge_background"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/ivy_cross_promotion_ad"
            android:textColor="@color/ivy_cross_promotion_white"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivy_cross_promotion_sound_toggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/ivy_cross_promotion_close_background"
            android:contentDescription="@null"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ivy_cross_promotion_ic_volume_up"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/ivy_cross_promotion_countdown"
        android:layout_width="44dp"
        android:layout_height="28dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/ivy_cross_promotion_countdown_background"
        android:gravity="center"
        android:textColor="@color/ivy_cross_promotion_white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ivy_cross_promotion_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ivy_cross_promotion_close_background"
        android:gravity="center"
        android:text="@string/ivy_cross_promotion_close_symbol"
        android:textColor="@color/ivy_cross_promotion_white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/ivy_cross_promotion_bottom_card"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="start|bottom"
        android:layout_margin="12dp"
        android:background="@drawable/ivy_cross_promotion_card_background"
        android:elevation="10dp"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ivy_cross_promotion_app_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="104dp"
            android:gravity="start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ivy_cross_promotion_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="#FF171A1F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ivy_cross_promotion_card_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="#FF747A84"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/ivy_cross_promotion_card_cta"
            android:layout_width="92dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/ivy_cross_promotion_landing_cta_background"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:text="@string/ivy_cross_promotion_install"
            android:textColor="@color/ivy_cross_promotion_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/ivy_cross_promotion_landscape_cta"
        android:layout_width="104dp"
        android:layout_height="44dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/ivy_cross_promotion_landing_cta_background"
        android:ellipsize="end"
        android:elevation="10dp"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:text="@string/ivy_cross_promotion_install"
        android:textColor="@color/ivy_cross_promotion_white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/ivy_cross_promotion_store_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/ivy_cross_promotion_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/ivy_cross_promotion_opening"
                android:textColor="@color/ivy_cross_promotion_white"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
